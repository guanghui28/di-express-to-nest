{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "paths": {
      "@controllers/*": ["./src/controllers/*"],
      "@decorators/*": ["./src/decorators/*"],
      "@services/*": ["./src/services/*"],
      "@core/*": ["./src/core/*"]
    },
    "types": ["node"]
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "include": ["src/**/*.ts"]
}
